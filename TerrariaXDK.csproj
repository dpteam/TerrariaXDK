<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>TerrariaXDK</AssemblyName>
    <GenerateAssemblyInfo>False</GenerateAssemblyInfo>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>True</UseWindowsForms>
    <TargetFramework>net40</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <CheckForOverflowUnderflow>False</CheckForOverflowUnderflow>
  </PropertyGroup>
  <PropertyGroup>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <RootNamespace />
  </PropertyGroup>
  <ItemGroup>
    <None Remove="Microsoft.Xna.Framework.Graphics.Effect.Resources.AlphaTestEffect.fxb" />
    <None Remove="Microsoft.Xna.Framework.Graphics.Effect.Resources.BasicEffect.fxb" />
    <None Remove="Microsoft.Xna.Framework.Graphics.Effect.Resources.DualTextureEffect.fxb" />
    <None Remove="Microsoft.Xna.Framework.Graphics.Effect.Resources.EnvironmentMapEffect.fxb" />
    <None Remove="Microsoft.Xna.Framework.Graphics.Effect.Resources.SkinnedEffect.fxb" />
    <None Remove="Microsoft.Xna.Framework.Graphics.Effect.Resources.SpriteEffect.fxb" />
    <None Remove="Microsoft.Xna.Framework.Graphics.Effect.Resources.YUVToRGBAEffect.fxb" />
    <EmbeddedResource Include="Microsoft.Xna.Framework.Graphics.Effect.Resources.AlphaTestEffect.fxb" LogicalName="Microsoft.Xna.Framework.Graphics.Effect.Resources.AlphaTestEffect.fxb" />
    <EmbeddedResource Include="Microsoft.Xna.Framework.Graphics.Effect.Resources.BasicEffect.fxb" LogicalName="Microsoft.Xna.Framework.Graphics.Effect.Resources.BasicEffect.fxb" />
    <EmbeddedResource Include="Microsoft.Xna.Framework.Graphics.Effect.Resources.DualTextureEffect.fxb" LogicalName="Microsoft.Xna.Framework.Graphics.Effect.Resources.DualTextureEffect.fxb" />
    <EmbeddedResource Include="Microsoft.Xna.Framework.Graphics.Effect.Resources.EnvironmentMapEffect.fxb" LogicalName="Microsoft.Xna.Framework.Graphics.Effect.Resources.EnvironmentMapEffect.fxb" />
    <EmbeddedResource Include="Microsoft.Xna.Framework.Graphics.Effect.Resources.SkinnedEffect.fxb" LogicalName="Microsoft.Xna.Framework.Graphics.Effect.Resources.SkinnedEffect.fxb" />
    <EmbeddedResource Include="Microsoft.Xna.Framework.Graphics.Effect.Resources.SpriteEffect.fxb" LogicalName="Microsoft.Xna.Framework.Graphics.Effect.Resources.SpriteEffect.fxb" />
    <EmbeddedResource Include="Microsoft.Xna.Framework.Graphics.Effect.Resources.YUVToRGBAEffect.fxb" LogicalName="Microsoft.Xna.Framework.Graphics.Effect.Resources.YUVToRGBAEffect.fxb" />
    <ApplicationConfig Remove="TerrariaXDK.exe.config" />
    <ApplicationConfig Include="TerrariaXDK.exe.config" />
  </ItemGroup>
  <ItemGroup>
    <!-- net40 reference assemblies are not part of every .NET SDK install (CI included).
         PrivateAssets keeps this a build-time-only dependency. -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="System.Core" />
    <Reference Include="System.Xml" />
  </ItemGroup>
  <!-- Examples are separate projects: building them into the game would duplicate their
       generated assembly attributes and pull test code into the executable.
       tools/** holds standalone utilities (build script, xnb2png) with their own projects. -->
  <ItemGroup>
    <Compile Remove="Examples/**/*.cs" />
    <None Remove="Examples/**" />
    <Compile Remove="tools/**/*.cs" />
    <None Remove="tools/**" />
  </ItemGroup>
</Project>